{
  "name": "afrimarket-equities",
  "version": "2.0.0",
  "private": true,
  "description": "Directory of African listed companies (hardened)",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --minify",
    "vendor": "node scripts/copy-vendor.js",
    "build": "npm run vendor && npm run build:css",
    "start": "node server.js",
    "audit": "npm audit --omit=dev"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.2",
    "chart.js": "4.4.3",
    "tailwindcss": "3.4.17"
  }
}
